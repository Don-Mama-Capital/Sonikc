# Base de données (en local : `npm run db` démarre un Postgres embarqué sur ce port)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/sonikc

# Secret pour signer les URL de fichiers et hacher les codes de connexion (32+ caractères)
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# URL publique de l'app
APP_URL=http://localhost:3000

# Stockage : "local" (dossier .data/storage) ou "supabase" (phase de mise en ligne)
STORAGE_DRIVER=local
STORAGE_DIR=.data/storage

# Emails : "local" (fichiers dans .data/mail) ou "resend" (mise en ligne)
MAIL_DRIVER=local
MAIL_DIR=.data/mail
# En production : en-tête IP posé par l'hébergeur (ex. x-real-ip sur Vercel). Vide = limites par IP désactivées.
TRUSTED_IP_HEADER=
